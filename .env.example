# ============================================================
# Islamic RAG Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and set your values.
# The .env file is NOT committed to version control.

# ------------------------------------------------------------------
# Paths (optional overrides — defaults resolve from project root)
# ------------------------------------------------------------------
# DATASET_PATH=./final_islamic_dataset.csv
# INDEX_CACHE_PATH=./faiss_index.bin
# METADATA_CACHE_PATH=./faiss_metadata.pkl

# ------------------------------------------------------------------
# Model Configuration
# ------------------------------------------------------------------
# Default LLM key: qwen | distilgpt2_finetuned | distilgpt2
DEFAULT_LLM_KEY=qwen

# ------------------------------------------------------------------
# Guardrail Settings
# ------------------------------------------------------------------
# Enable/disable the Islamic topic filter (true | false)
GUARDRAIL_ENABLED=true

# Cosine similarity threshold [0.0 - 1.0]
# Lower = more permissive, higher = stricter Islamic-only filtering
TOPIC_THRESHOLD=0.30

# ------------------------------------------------------------------
# API Rate Limiting
# ------------------------------------------------------------------
# Requests per minute per IP address
RATE_LIMIT=10

# ------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
